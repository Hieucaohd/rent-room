{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug with Nodemon",
      "runtimeExecutable": "nodemon",
      "runtimeArgs": [
        "--exec",
        "node_modules/.bin/babel-node",
        "--inspect",
        "${workspaceFolder}/index.js"
      ],
      "env": {
        "NODE_OPTIONS": "--inspect=9250"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
